ı müfredat ve materyallerle online Python dersleri yürütmek • Öğrencileri Python programlama dili ve temel yazılım…","apply_url":"","validThrough":"","first_seen":"2026-10-17T10:22:16.150Z","last_seen":"2026-10-24T20:57:11.694Z"},"d63bb2ae70cf2888":{"description":"","apply_url":"","validThrough":"","first_seen":"2026-10-18T20:51:50.717Z","last_seen":"2026-10-23T11:56:58.834Z"},"d6a87e66abb4d36b":{"description":"","apply_url":"","validThrough":"","first_seen":"2026-10-18T15:57:01.312Z","last_seen":"2026-10-18T15:57:01.312Z"}}